! Generated by fabric/generate.py from intent.yml - do not edit by hand
frr defaults datacenter
hostname {{ name }}
service integrated-vtysh-config
!
interface lo
 ip address {{ loopback }}/32
!
{% for l in links %}
interface {{ l.ifname }}
 description to-{{ l.peer }}
 ip address {{ l.ip }}/31
!
{% endfor %}
bfd
 profile fast
  transmit-interval {{ bfd.interval_ms }}
  receive-interval {{ bfd.interval_ms }}
  detect-multiplier {{ bfd.multiplier }}
 exit
 !
exit
!
router bgp {{ asn }}
 bgp router-id {{ loopback }}
 no bgp ebgp-requires-policy
 bgp bestpath as-path multipath-relax
{% for l in links %}
 neighbor {{ l.peer_ip }} remote-as {{ l.peer_asn }}
 neighbor {{ l.peer_ip }} description {{ l.peer }}
{% if bfd.enabled %}
 neighbor {{ l.peer_ip }} bfd profile fast
{% endif %}
{% endfor %}
 !
 ! Underlay: advertise the loopback (also the VXLAN tunnel endpoint on leaves)
 address-family ipv4 unicast
  network {{ loopback }}/32
  maximum-paths 8
 exit-address-family
 !
 ! Overlay: EVPN carries MAC/IP reachability between leaves
 address-family l2vpn evpn
{% for l in links %}
  neighbor {{ l.peer_ip }} activate
{% if role == "spine" %}
  neighbor {{ l.peer_ip }} attribute-unchanged next-hop
{% endif %}
{% endfor %}
{% if role == "leaf" %}
  advertise-all-vni
{% for v in vnis %}
  vni {{ v.vni }}
   route-target import {{ rt_asn }}:{{ v.vni }}
   route-target export {{ rt_asn }}:{{ v.vni }}
  exit-vni
{% endfor %}
{% endif %}
 exit-address-family
!
