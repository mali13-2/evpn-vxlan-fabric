! Generated by fabric/generate.py from intent.yml - do not edit by hand
frr defaults datacenter
hostname {{ name }}
service integrated-vtysh-config
!
interface lo
 ip address {{ loopback }}/32
!
{% for l in links %}
interface {{ l.ifname }}
 description to-{{ l.peer }}
 ip address {{ l.ip }}/31
!
{% endfor %}
router bgp {{ asn }}
 bgp router-id {{ loopback }}
 no bgp ebgp-requires-policy
 bgp bestpath as-path multipath-relax
{% for l in links %}
 neighbor {{ l.peer_ip }} remote-as {{ l.peer_asn }}
 neighbor {{ l.peer_ip }} description {{ l.peer }}
{% endfor %}
 !
 address-family ipv4 unicast
  network {{ loopback }}/32
  maximum-paths 8
 exit-address-family
!
