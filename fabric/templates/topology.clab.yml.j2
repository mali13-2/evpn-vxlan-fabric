# Generated by fabric/generate.py from intent.yml - do not edit by hand
name: {{ fabric.name }}

topology:
  defaults:
    kind: linux
    image: {{ fabric.image }}

  nodes:
{% for n in nodes %}
    {{ n.name }}:
      binds:
        - {{ n.name }}/daemons:/etc/frr/daemons
        - {{ n.name }}/frr.conf:/etc/frr/frr.conf
{% endfor %}

  links:
{% for c in cables %}
    - endpoints: ["{{ c.a }}", "{{ c.b }}"]
{% endfor %}
